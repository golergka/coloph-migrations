#!/bin/sh
set -eu

mode=${1:-commit}

uv run ruff check .

if [ "$mode" != commit ]; then
    if ! docker info >/dev/null 2>&1; then
        echo "Docker is required for database tests. Start Docker, then run this check again." >&2
        exit 2
    fi
    uv lock --check
    uv run pytest -q
fi

if [ "$mode" = integration ]; then
    version=$(uv run python -c 'import tomllib; print(tomllib.load(open("pyproject.toml", "rb"))["project"]["version"])')
    python scripts/release.py build --tag "v$version"
fi
